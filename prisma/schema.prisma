generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ActivityAction {
  UPMAN_GRANTED
  UPMAN_REMOVED
  UPMAN_CREATED
  UPMAN_UPDATED
  UPMAN_DELETED
  PULL_RESOLVED
  PERSON_CREATED
  PERSON_UPDATED
  UPMAN_RELATIONSHIPS_UPDATED
  PROFILE_COSMETIC_CREATED
  PROFILE_COSMETIC_UPDATED
  PROFILE_COSMETIC_DELETED
  UPMAN_ACQUISITION_RESOLVED
}

enum PullResult {
  NEW
  DUPLICATE
}

enum ActivityOrigin {
  ADMIN
  STREAMERBOT
  IMPORT
  SYSTEM
}

enum PersonLinkPlatform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  BLUESKY
  X
  GITHUB
  WEBSITE
  PORTFOLIO
}

enum ProfileCosmeticAssetType {
  BACKGROUND
  BANNER
}

enum UpmanDexVisibility {
  PUBLIC
  HIDDEN
}

enum UpmanAcquisitionMethod {
  EVENT_REDEEM
  STREAM_COMMAND
  SITE_SECRET
  MANUAL
}

enum UpmanAcquisitionResult {
  NEW
  DUPLICATE
}

model User {
  id               String        @id @default(cuid())
  twitchLogin      String        @unique
  twitchUserId     String?       @unique
  displayName      String
  avatar           String?
  role             UserRole      @default(USER)
  createdAt        DateTime      @default(now())
  inventory        Inventory[]
  pullEvents       PullEvent[]
  acquisitionGrants UpmanAcquisitionGrant[]
  activityAsActor  ActivityLog[] @relation("ActivityActor")
  activityAsTarget ActivityLog[] @relation("ActivityTarget")
  person           Person?
}

model Person {
  id                               String                @id @default(cuid())
  displayName                      String
  userId                           String?               @unique
  isPublic                         Boolean               @default(true)
  equippedTitleAchievementKey      String?
  equippedBackgroundAchievementKey String?
  equippedBannerAchievementKey     String?
  equippedAccentAchievementKey     String?
  equippedCustomBackgroundId       String?
  equippedCustomBannerId           String?
  featuredAchievementKeys          String[]              @default([])
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdUpmans                    Upman[]               @relation("UpmanCreatorPerson")
  representedUpmans                Upman[]               @relation("UpmanRepresentedPerson")
  activityLogs                     ActivityLog[]         @relation("ActivityPerson")
  achievements                     PersonAchievement[]
  artworks                         PersonArtwork[]
  projects                         PersonProject[]
  links                            PersonLink[]
  equippedCustomBackground         ProfileCosmeticAsset? @relation("PersonCustomBackground", fields: [equippedCustomBackgroundId], references: [id], onDelete: SetNull)
  equippedCustomBanner             ProfileCosmeticAsset? @relation("PersonCustomBanner", fields: [equippedCustomBannerId], references: [id], onDelete: SetNull)

  @@index([displayName])
  @@index([equippedCustomBackgroundId])
  @@index([equippedCustomBannerId])
}

model ProfileCosmeticAsset {
  id        String                   @id @default(cuid())
  type      ProfileCosmeticAssetType
  name      String
  image     String
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  backgroundEquippedBy Person[] @relation("PersonCustomBackground")
  bannerEquippedBy     Person[] @relation("PersonCustomBanner")

  @@index([type, createdAt])
}

model PersonLink {
  id        String             @id @default(cuid())
  personId  String
  platform  PersonLinkPlatform
  url       String
  position  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  person    Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, platform])
  @@index([personId, position])
}

model PersonProject {
  id          String   @id @default(cuid())
  personId    String
  title       String
  description String
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, position])
}

model PersonArtwork {
  id        String   @id @default(cuid())
  personId  String
  image     String
  title     String?
  position  Int
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, position])
}

model PersonAchievement {
  id             String   @id @default(cuid())
  personId       String
  achievementKey String
  unlockedAt     DateTime @default(now())
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, achievementKey])
  @@index([personId, unlockedAt])
}

model Upman {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String
  image               String
  rarity              String
  creator             String
  creatorTwitch       String?
  creatorPersonId     String?
  representedPersonId String?
  ownersCount         Int           @default(0)
  firstOwner          String?
  isPullable          Boolean       @default(true)
  dexVisibility       UpmanDexVisibility @default(PUBLIC)
  createdAt           DateTime      @default(now())
  inventory           Inventory[]
  pullEvents          PullEvent[]
  acquisitionRules    UpmanAcquisitionRule[]
  acquisitionGrants   UpmanAcquisitionGrant[]
  activityLogs        ActivityLog[]
  creatorPerson       Person?       @relation("UpmanCreatorPerson", fields: [creatorPersonId], references: [id], onDelete: SetNull)
  representedPerson   Person?       @relation("UpmanRepresentedPerson", fields: [representedPersonId], references: [id], onDelete: SetNull)

  @@index([creatorPersonId])
  @@index([representedPersonId])
}

model UpmanEvent {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isEnabled Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acquisitionRules UpmanAcquisitionRule[]

  @@index([isEnabled, startsAt, endsAt])
}

model UpmanAcquisitionRule {
  id                       String                   @id @default(cuid())
  upmanId                  String
  method                   UpmanAcquisitionMethod
  externalKey              String?
  isEnabled                Boolean                  @default(true)
  eventId                  String?
  requiredTwitchCategoryId String?
  siteSecretHash           String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  upman  Upman       @relation(fields: [upmanId], references: [id], onDelete: Cascade)
  event  UpmanEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  grants UpmanAcquisitionGrant[]

  @@unique([method, externalKey])
  @@index([upmanId])
  @@index([eventId])
}

model UpmanAcquisitionGrant {
  id             String                   @id @default(cuid())
  idempotencyKey String                   @unique
  ruleId         String
  userId         String?
  upmanId        String
  twitchUserId   String?
  twitchLogin    String
  displayName    String
  result         UpmanAcquisitionResult
  createdAt      DateTime                 @default(now())

  rule  UpmanAcquisitionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  upman Upman                @relation(fields: [upmanId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([userId, createdAt])
  @@index([upmanId, createdAt])
}

model PullRarityRule {
  rarity  String  @id
  weight  Int
  enabled Boolean @default(true)
}

model PullEvent {
  id        String         @id @default(cuid())
  requestId String         @unique
  result    PullResult
  origin    ActivityOrigin @default(STREAMERBOT)
  createdAt DateTime       @default(now())

  userId       String?
  twitchUserId String
  twitchLogin  String
  displayName  String

  upmanId      String?
  upmanSlug    String
  upmanName    String
  upmanRarity  String
  upmanImage   String
  upmanCreator String

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  upman Upman? @relation(fields: [upmanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([upmanId, createdAt])
  @@index([origin, createdAt])
}

model Inventory {
  id         String   @id @default(cuid())
  userId     String
  upmanId    String
  obtainedAt DateTime @default(now())
  upman      Upman    @relation(fields: [upmanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, upmanId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  action    ActivityAction
  origin    ActivityOrigin
  createdAt DateTime       @default(now())

  actorUserId String?
  actorLogin  String?

  targetUserId String?
  targetLogin  String?

  upmanId           String?
  upmanSlug         String?
  upmanName         String?
  personId          String?
  personDisplayName String?

  metadata Json?

  actorUser  User?   @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User?   @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  upman      Upman?  @relation(fields: [upmanId], references: [id], onDelete: SetNull)
  person     Person? @relation("ActivityPerson", fields: [personId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([origin, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([upmanId, createdAt])
  @@index([personId, createdAt])
}
