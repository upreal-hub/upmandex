generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ActivityAction {
  UPMAN_GRANTED
  UPMAN_REMOVED
  UPMAN_CREATED
  UPMAN_UPDATED
  UPMAN_DELETED
  PULL_RESOLVED
  PERSON_CREATED
  PERSON_UPDATED
  UPMAN_RELATIONSHIPS_UPDATED
}

enum PullResult {
  NEW
  DUPLICATE
}

enum ActivityOrigin {
  ADMIN
  STREAMERBOT
  IMPORT
  SYSTEM
}

model User {
  id           String      @id @default(cuid())
  twitchLogin  String      @unique
  twitchUserId String?     @unique
  displayName  String
  avatar       String?
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now())
  inventory    Inventory[]
  pullEvents   PullEvent[]
  activityAsActor  ActivityLog[] @relation("ActivityActor")
  activityAsTarget ActivityLog[] @relation("ActivityTarget")
  person           Person?
}

model Person {
  id                  String        @id @default(cuid())
  displayName         String
  userId              String?       @unique
  isPublic            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdUpmans       Upman[]       @relation("UpmanCreatorPerson")
  representedUpmans   Upman[]       @relation("UpmanRepresentedPerson")
  activityLogs        ActivityLog[] @relation("ActivityPerson")

  @@index([displayName])
}

model Upman {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  image         String
  rarity        String
  creator       String
  creatorTwitch String?
  creatorPersonId String?
  representedPersonId String?
  ownersCount   Int         @default(0)
  firstOwner    String?
  isPullable    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  inventory     Inventory[]
  pullEvents    PullEvent[]
  activityLogs  ActivityLog[]
  creatorPerson Person? @relation("UpmanCreatorPerson", fields: [creatorPersonId], references: [id], onDelete: SetNull)
  representedPerson Person? @relation("UpmanRepresentedPerson", fields: [representedPersonId], references: [id], onDelete: SetNull)

  @@index([creatorPersonId])
  @@index([representedPersonId])
}

model PullRarityRule {
  rarity  String  @id
  weight  Int
  enabled Boolean @default(true)
}

model PullEvent {
  id        String         @id @default(cuid())
  requestId String         @unique
  result    PullResult
  origin    ActivityOrigin @default(STREAMERBOT)
  createdAt DateTime       @default(now())

  userId       String?
  twitchUserId String
  twitchLogin  String
  displayName  String

  upmanId      String?
  upmanSlug    String
  upmanName    String
  upmanRarity  String
  upmanImage   String
  upmanCreator String

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  upman Upman? @relation(fields: [upmanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([upmanId, createdAt])
  @@index([origin, createdAt])
}

model Inventory {
  id         String   @id @default(cuid())
  userId     String
  upmanId    String
  obtainedAt DateTime @default(now())
  upman      Upman    @relation(fields: [upmanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, upmanId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  action    ActivityAction
  origin    ActivityOrigin
  createdAt DateTime       @default(now())

  actorUserId String?
  actorLogin  String?

  targetUserId String?
  targetLogin  String?

  upmanId   String?
  upmanSlug String?
  upmanName String?
  personId String?
  personDisplayName String?

  metadata Json?

  actorUser  User?  @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User?  @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  upman      Upman? @relation(fields: [upmanId], references: [id], onDelete: SetNull)
  person     Person? @relation("ActivityPerson", fields: [personId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([origin, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([upmanId, createdAt])
  @@index([personId, createdAt])
}
