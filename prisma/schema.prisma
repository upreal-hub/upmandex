generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ActivityAction {
  UPMAN_GRANTED
  UPMAN_REMOVED
  UPMAN_CREATED
  UPMAN_UPDATED
  UPMAN_DELETED
}

enum ActivityOrigin {
  ADMIN
  STREAMERBOT
  IMPORT
  SYSTEM
}

model User {
  id          String      @id @default(cuid())
  twitchLogin String      @unique
  displayName String
  avatar      String?
  role        UserRole    @default(USER)
  createdAt   DateTime    @default(now())
  inventory   Inventory[]
  activityAsActor  ActivityLog[] @relation("ActivityActor")
  activityAsTarget ActivityLog[] @relation("ActivityTarget")
}

model Upman {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  image         String
  rarity        String
  creator       String
  creatorTwitch String?
  ownersCount   Int         @default(0)
  firstOwner    String?
  createdAt     DateTime    @default(now())
  inventory     Inventory[]
  activityLogs  ActivityLog[]
}

model Inventory {
  id         String   @id @default(cuid())
  userId     String
  upmanId    String
  obtainedAt DateTime @default(now())
  upman      Upman    @relation(fields: [upmanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, upmanId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  action    ActivityAction
  origin    ActivityOrigin
  createdAt DateTime       @default(now())

  actorUserId String?
  actorLogin  String?

  targetUserId String?
  targetLogin  String?

  upmanId   String?
  upmanSlug String?
  upmanName String?

  metadata Json?

  actorUser  User?  @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User?  @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  upman      Upman? @relation(fields: [upmanId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([origin, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([upmanId, createdAt])
}
